\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{xeCJK}[2026/09/20 Ratex native CJK font selection]
\DeclareOption*{\PackageError{xeCJK}{Unsupported package option \CurrentOption}{Ratex supports horizontal CJK native font selection and Unicode line breaking.}}
\ProcessOptions\relax
\RequirePackage{fontspec}
\ExplSyntaxOn
\tl_new:N \g_ratex_cjk_defaults_tl
\tl_new:N \g_ratex_cjk_main_tl
\tl_new:N \g_ratex_cjk_sans_tl
\tl_new:N \g_ratex_cjk_mono_tl
\tl_new:N \l_ratex_cjk_selected_tl
\tl_new:N \l_ratex_cjk_target_tl
\prop_new:N \g_ratex_cjk_families_prop
\bool_new:N \l_ratex_cjk_syncing_bool
\cs_new_protected:Npn \ratex_cjk_sync:
  {
    \bool_if:NF \l_ratex_cjk_syncing_bool
      {
        \tl_set_eq:NN \l_ratex_cjk_target_tl \l_ratex_cjk_selected_tl
        \tl_if_empty:NT \l_ratex_cjk_target_tl
          {
            \tl_set_eq:NN \l_ratex_cjk_target_tl \g_ratex_cjk_main_tl
            \str_if_eq:eeT {\f@family}{\sfdefault}
              {\tl_if_empty:NF \g_ratex_cjk_sans_tl {\tl_set_eq:NN \l_ratex_cjk_target_tl \g_ratex_cjk_sans_tl}}
            \str_if_eq:eeT {\f@family}{\ttdefault}
              {\tl_if_empty:NF \g_ratex_cjk_mono_tl {\tl_set_eq:NN \l_ratex_cjk_target_tl \g_ratex_cjk_mono_tl}}
          }
        \tl_if_empty:NF \l_ratex_cjk_target_tl
          {
            \cs_set_protected:Npx \ratex@cjkfont
              {
                \exp_not:n
                  {\group_begin: \bool_set_true:N \l_ratex_cjk_syncing_bool}
                \exp_not:N \ratex_font_select:n {\exp_not:V \l_ratex_cjk_target_tl}
                \exp_not:n
                  {\use:x {\group_end: \tex_let:D \exp_not:N \ratex@cjkfont \tex_the:D \tex_font:D}}
              }
          }
      }
  }
\AddToHook{selectfont}{\ratex_cjk_sync:}
\NewDocumentCommand \setCJKmainfont {O{} m O{}}
  {
    \ratex_font_declare:nnn {#2}{\g_ratex_cjk_defaults_tl,#1,#3}{}
    \tl_gset_eq:NN \g_ratex_cjk_main_tl \l_ratex_font_family_tl
    \ratex_cjk_sync:
  }
\NewDocumentCommand \setCJKsansfont {O{} m O{}}
  {
    \ratex_font_declare:nnn {#2}{\g_ratex_cjk_defaults_tl,#1,#3}{}
    \tl_gset_eq:NN \g_ratex_cjk_sans_tl \l_ratex_font_family_tl
    \ratex_cjk_sync:
  }
\NewDocumentCommand \setCJKmonofont {O{} m O{}}
  {
    \ratex_font_declare:nnn {#2}{\g_ratex_cjk_defaults_tl,#1,#3}{}
    \tl_gset_eq:NN \g_ratex_cjk_mono_tl \l_ratex_font_family_tl
    \ratex_cjk_sync:
  }
\NewDocumentCommand \setCJKfamilyfont {m O{} m O{}}
  {
    \ratex_font_declare:nnn {#3}{\g_ratex_cjk_defaults_tl,#2,#4}{}
    \prop_gput:NnV \g_ratex_cjk_families_prop {#1} \l_ratex_font_family_tl
  }
\NewDocumentCommand \CJKfamily {m}
  {
    \prop_get:NnNTF \g_ratex_cjk_families_prop {#1} \l_ratex_cjk_selected_tl
      {\ratex_cjk_sync:}
      {\PackageError{xeCJK}{Unknown~CJK~family~#1}{Declare~it~with~setCJKfamilyfont~first.}}
  }
\cs_new_protected:Npn \ratex_cjk_select:n #1
  {\tl_set:Nn \l_ratex_cjk_selected_tl {#1}\ratex_cjk_sync:}
\NewDocumentCommand \newCJKfontfamily {m O{} m O{}}
  {
    \ratex_font_declare:nnn {#3}{\g_ratex_cjk_defaults_tl,#2,#4}{#1}
    \use:x
      {
        \exp_not:N \DeclareRobustCommand \exp_not:N #1
          {\exp_not:N \ratex_cjk_select:n {\l_ratex_font_family_tl}}
      }
  }
\NewDocumentCommand \defaultCJKfontfeatures {m}
  {\tl_gset:Nn \g_ratex_cjk_defaults_tl {#1}}
\NewDocumentCommand \xeCJKsetup {m}
  {\PackageError{xeCJK}{Unsupported~xeCJKsetup~request}{Use~native~font~selection~options;~upstream~XeTeX~inter-character~configuration~is~not~implemented.}}
\ExplSyntaxOff
\endinput
